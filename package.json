{
  "name": "kai-morning-videos",
  "version": "1.0.0",
  "description": "Free, private, buildless KAI Level 1 morning study guide",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "python3 scripts/build.py",
    "preview": "python3 -m http.server 8765 --bind 127.0.0.1",
    "test": "playwright test --project=chrome-desktop --project=webkit-iphone --project=webkit-ipad",
    "test:firefox": "playwright test --project=firefox-desktop --project=firefox-phone",
    "verify:videos": "python3 scripts/verify-videos.py"
  },
